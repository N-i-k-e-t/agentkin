{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "api/**/*.ts", "server/**/*.ts"]
}
